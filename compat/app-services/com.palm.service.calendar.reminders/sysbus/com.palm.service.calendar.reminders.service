#
# The calendar reminders service of Open webOS (third_party/app-services),
# run by OSE's mojoservicelauncher (run-js-service).
# The original's sysbus files are luna-service 1's; these are OSE's
# (compat/app-services/README.md).

[D-BUS Service]
Name=com.palm.service.calendar.reminders
Exec=/usr/bin/run-js-service -n /usr/palm/services/com.palm.service.calendar.reminders
Type=dynamic
