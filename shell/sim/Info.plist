<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (c) 2026 webOS Phoenix contributors
  SPDX-License-Identifier: Apache-2.0

  phoenix-sim's Info.plist on macOS, linked into the program (__TEXT,__info_plist;
  shell/CMakeLists.txt): the name the menu bar's application menu and the About
  box show. Only the name: the settings and data folders come from the program's
  organization and application names (main.cpp), which stay as they were.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Phoenix WebOS Simulator</string>
    <key>CFBundleDisplayName</key>
    <string>Phoenix WebOS Simulator</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>The simulated device's microphone: dictation and Voice Dial.</string>
    <!-- Simulate > Location > This Computer's Location (Qt Positioning, CoreLocation). -->
    <key>NSLocationUsageDescription</key>
    <string>The simulated device can be where this Mac is (Simulate &gt; Location).</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>The simulated device can be where this Mac is (Simulate &gt; Location).</string>
</dict>
</plist>
