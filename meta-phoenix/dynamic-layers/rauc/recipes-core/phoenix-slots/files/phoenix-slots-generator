#
# A systemd generator (systemd.generator(7)): the A/B layout's mounts, when
# the boot loader says the system started from one of two root slots
# (docs/PLATFORM-CLIENT.md, "System updates"; phoenix-ab-grub.cfg passes
# them):
#
#   phoenix.data=PARTLABEL=phoenix-data   the data partition, at /data
#   phoenix.esp=PARTLABEL=phoenix-boot    the EFI system partition, at
#                                         /boot/efi (GRUB's environment,
#                                         which RAUC writes)
#
# What is the user's must outlive an update, which replaces the whole root:
# /var, /home and /media are overlays whose upper layers are on the data
# partition and whose lower layers are the running slot's own directories.
# So what the user changed stays (in the upper layer), and what they did
# not change is always the running system's: a file the new image changed
# shows the new copy, with no copying at the update. /var/lib/phoenix
# (com.palm.update's downloads and state, dev push's overlays, which
# overlayfs cannot have as upper layers on another overlay) is a plain
# directory on the data partition.
#
# Without phoenix.data= (the root image started on its own, as scripts/vm.sh
# and UTM's kernel boot do) nothing is generated: the system runs from its
# root alone, as before.
#
# The environment variables are for the tests (tools/test-rauc-slots.py).

set -eu

OUT=${1:-/run/systemd/generator}
CMDLINE=${PHOENIX_CMDLINE:-/proc/cmdline}
DATA_DIR=/data

data=
esp=
# The command line is one line of words: split on purpose.
# shellcheck disable=SC2013
for arg in $(cat "$CMDLINE"); do
    case $arg in
        phoenix.data=*) data=${arg#phoenix.data=} ;;
        phoenix.esp=*) esp=${arg#phoenix.esp=} ;;
    esac
done
[ -n "$data" ] || exit 0

device() {
    case $1 in
        PARTLABEL=*) echo "/dev/disk/by-partlabel/${1#PARTLABEL=}" ;;
        PARTUUID=*) echo "/dev/disk/by-partuuid/${1#PARTUUID=}" ;;
        LABEL=*) echo "/dev/disk/by-label/${1#LABEL=}" ;;
        UUID=*) echo "/dev/disk/by-uuid/${1#UUID=}" ;;
        /dev/*) echo "$1" ;;
        *) return 1 ;;
    esac
}

# systemd's escaping of a path for a unit name (systemd-escape --path), for
# the device paths above: "-" and other bytes outside [A-Za-z0-9:_.] as \xNN.
escape_path() {
    p=${1#/}
    out=
    while [ -n "$p" ]; do
        c=${p%"${p#?}"}
        p=${p#?}
        case $c in
            /) out="$out-" ;;
            [A-Za-z0-9:_.]) out="$out$c" ;;
            *) out="$out$(printf '\\x%02x' "'$c")" ;;
        esac
    done
    # printf, not echo: some shells' echo would turn \x2d back into "-"
    printf '%s\n' "$out"
}

wants() {
    mkdir -p "$OUT/local-fs.target.wants"
    ln -sf "../$1" "$OUT/local-fs.target.wants/$1"
}

if ! data_dev=$(device "$data"); then
    echo "phoenix-slots-generator: phoenix.data=$data is not a device; no data partition" >&2
    exit 0
fi
fsck="systemd-fsck@$(escape_path "$data_dev").service"

cat > "$OUT/data.mount" <<EOF
# Generated by phoenix-slots-generator from phoenix.data= (do not edit)
[Unit]
Description=webOS Phoenix data partition
Documentation=https://github.com/thebestbradley/webos-phoenix/blob/main/docs/PLATFORM-CLIENT.md#system-updates
DefaultDependencies=no
Requires=$fsck
After=$fsck
Before=local-fs.target umount.target
Conflicts=umount.target

[Mount]
What=$data_dev
Where=$DATA_DIR
Type=ext4
Options=defaults,noatime
EOF
wants data.mount

cat > "$OUT/phoenix-data-prepare.service" <<EOF
# Generated by phoenix-slots-generator (do not edit)
[Unit]
Description=webOS Phoenix data partition: the overlays' directories
DefaultDependencies=no
RequiresMountsFor=$DATA_DIR
Before=local-fs.target var.mount home.mount media.mount var-lib-phoenix.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p $DATA_DIR/overlay/var/upper $DATA_DIR/overlay/var/work $DATA_DIR/overlay/home/upper $DATA_DIR/overlay/home/work $DATA_DIR/overlay/media/upper $DATA_DIR/overlay/media/work $DATA_DIR/phoenix $DATA_DIR/rauc
EOF

for dir in var home media; do
    cat > "$OUT/$dir.mount" <<EOF
# Generated by phoenix-slots-generator (do not edit)
[Unit]
Description=webOS Phoenix: /$dir kept on the data partition
DefaultDependencies=no
RequiresMountsFor=$DATA_DIR
Requires=phoenix-data-prepare.service
After=phoenix-data-prepare.service
Before=local-fs.target umount.target
Conflicts=umount.target

[Mount]
What=overlay
Where=/$dir
Type=overlay
Options=lowerdir=/$dir,upperdir=$DATA_DIR/overlay/$dir/upper,workdir=$DATA_DIR/overlay/$dir/work
EOF
    wants "$dir.mount"
done

cat > "$OUT/var-lib-phoenix.mount" <<EOF
# Generated by phoenix-slots-generator (do not edit)
[Unit]
Description=webOS Phoenix: /var/lib/phoenix on the data partition
DefaultDependencies=no
RequiresMountsFor=$DATA_DIR /var
Requires=phoenix-data-prepare.service
After=phoenix-data-prepare.service var.mount
Before=local-fs.target umount.target
Conflicts=umount.target

[Mount]
What=$DATA_DIR/phoenix
Where=/var/lib/phoenix
Type=none
Options=bind
EOF
wants var-lib-phoenix.mount

if [ -n "$esp" ]; then
    if esp_dev=$(device "$esp"); then
        cat > "$OUT/boot-efi.mount" <<EOF
# Generated by phoenix-slots-generator from phoenix.esp= (do not edit)
[Unit]
Description=webOS Phoenix EFI system partition (the boot loader's environment)
DefaultDependencies=no
Before=local-fs.target umount.target
Conflicts=umount.target

[Mount]
What=$esp_dev
Where=/boot/efi
Type=vfat
Options=umask=0077,noatime,flush
EOF
        wants boot-efi.mount
    else
        echo "phoenix-slots-generator: phoenix.esp=$esp is not a device" >&2
    fi
fi
