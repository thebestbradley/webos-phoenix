         pThis->lunaServiceCall(SCAN_METHOD, SCAN_PAYLOAD, scanCb, &(pThis->mScanToken), true);
     else if (pThis->mtelephonyPowerd)
@@ -370,12 +483,21 @@ ErrorCodes  NetworkPositionProvider::processRequest(PositionRequest request) {
                 }
             }
 
+            // Another of the account's devices' position first, when this
