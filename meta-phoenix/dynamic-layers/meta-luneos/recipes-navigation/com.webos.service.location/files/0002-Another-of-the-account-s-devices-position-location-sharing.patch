     g_assert_false(untouched.set);
 }
 
+/* The account service's locationRelay reply (location sharing). */
+static void test_relay_position(void) {
+    RelayPosition p;
+    g_assert_true(parseRelayPosition("{\"returnValue\":true,\"enabled\":true,\"sharing\":true,\"reason\":null,"
+                                     "\"position\":{\"latitude\":51.5007,\"longitude\":-0.1246,\"accuracy\":8.5,"
+                                     "\"altitude\":21,\"heading\":null,\"speed\":0,\"timestamp\":1795000000000,\"age\":42,"
+                                     "\"source\":{\"kind\":\"browser\",\"name\":\"iPad\",\"deviceId\":null}}}", &p));
+    g_assert_true(p.set);
+    g_assert_cmpfloat(p.latitude, ==, 51.5007);
+    g_assert_cmpfloat(p.longitude, ==, -0.1246);
+    g_assert_cmpfloat(p.accuracy, ==, 8.5);
+    g_assert_cmpfloat(p.altitude, ==, 21);
+    g_assert_cmpfloat(p.heading, ==, -1);
+    g_assert_cmpfloat(p.speed, ==, 0);
+    g_assert_cmpfloat(p.age, ==, 42);
+    g_assert_cmpstr(p.source.c_str(), ==, "iPad");
+
+    // No accuracy: 100 m; one below 1 m is 1 m; no age: 0.
+    RelayPosition q;
+    g_assert_true(parseRelayPosition("{\"returnValue\":true,\"position\":{\"latitude\":1,\"longitude\":2}}", &q));
+    g_assert_cmpfloat(q.accuracy, ==, 100);
+    g_assert_cmpfloat(q.age, ==, 0);
+    g_assert_true(parseRelayPosition("{\"returnValue\":true,\"position\":{\"latitude\":1,\"longitude\":2,\"accuracy\":0.2}}", &q));
+    g_assert_cmpfloat(q.accuracy, ==, 1);
+
+    // None: off, no position, an error, not a position.
+    RelayPosition untouched;
+    g_assert_false(parseRelayPosition("{\"returnValue\":true,\"enabled\":false,\"position\":null,\"reason\":\"OFF\"}", &untouched));
+    g_assert_false(parseRelayPosition("{\"returnValue\":false,\"errorCode\":\"NOT_ALLOWED\"}", &untouched));
+    g_assert_false(parseRelayPosition("{\"returnValue\":false,\"position\":{\"latitude\":1,\"longitude\":2}}", &untouched));
+    g_assert_false(parseRelayPosition("{\"returnValue\":true,\"position\":{\"latitude\":95,\"longitude\":2}}", &untouched));
+    g_assert_false(parseRelayPosition("{\"returnValue\":true,\"position\":{\"latitude\":0,\"longitude\":0}}", &untouched));
+    g_assert_false(parseRelayPosition("{\"returnValue\":true,\"position\":{\"latitude\":\"1\",\"longitude\":2}}", &untouched));
+    g_assert_false(parseRelayPosition("", &untouched));
+    g_assert_false(parseRelayPosition(NULL, &untouched));
+    g_assert_false(untouched.set);
+}
