diff --git a/include/NetworkLocationBackend.h b/include/NetworkLocationBackend.h
index 0d1b453..648cde6 100644
--- a/include/NetworkLocationBackend.h
+++ b/include/NetworkLocationBackend.h
@@ -99,6 +99,31 @@ bool parseManualPosition(const char *json, ManualPosition *out);
 /* The JSON stored and reported for a position. */
 std::string manualPositionJson(const ManualPosition &position);
 
+/*
+ * Another of the account's devices' position (webOS Phoenix's location
+ * sharing): Safari on the iPad a VM runs on, a Shortcut, a phone with GPS.
+ * The account service (org.webosphoenix.service.account/locationRelay)
+ * answers {returnValue, enabled, position: {latitude, longitude, accuracy,
+ * altitude, heading, speed, age (seconds), source: {name}} | null, reason}.
+ */
+#define RELAY_POSITION_METHOD "luna://org.webosphoenix.service.account/locationRelay"
+
+struct RelayPosition {
+    bool set = false;
+    double latitude = 0;
+    double longitude = 0;
+    double accuracy = 0;      /* metres, 1 m to 100 km */
+    double altitude = -1;     /* -1: not known, as GeoLocation takes it */
+    double heading = -1;
+    double speed = -1;
+    double age = 0;           /* seconds since it was measured */
+    std::string source;       /* the device it came from, for the log */
+};
+
+/* From the account service's reply: false (and out unset) when it carries no
+ * position (sharing off here or on the account, none fresh, no service). */
+bool parseRelayPosition(const char *reply, RelayPosition *out);
+
 /* The body of a request with no radios: the server places the device by its
  * IP address (beaconDB, Google and Phoenix's service all take it). */
 #define IP_ONLY_GEOLOCATE_QUERY "{\"considerIp\":true}"
