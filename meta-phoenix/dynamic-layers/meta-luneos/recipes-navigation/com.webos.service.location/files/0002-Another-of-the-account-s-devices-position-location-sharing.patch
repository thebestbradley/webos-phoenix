index baa83c4..9edc5cc 100644
--- a/include/NetworkPositionProvider.h
+++ b/include/NetworkPositionProvider.h
@@ -195,6 +195,21 @@ private:
 
     static gboolean manualReplyCb(gpointer obj);
 
+    /* Another of the account's devices' position (location sharing),
+     * asked of the account service at each request and with each 60 s
+     * update. While it has one (RELAY_HOLD_MS after it last did), the
+     * network handler answers with it, ahead of the user's own (manual)
+     * position, and posts no Wi-Fi, cell or IP query. */
+    void askRelay();
+
+    void relayAnswered(const RelayPosition *position);
+
+    bool relayFresh() const;
+
+    static bool relayCb(LSHandle *sh, LSMessage *reply, void *ctx);
+
+    static gboolean relayTimeoutCb(gpointer obj);
+
     template<typename T>
     bool parseWifiData(T& jsonObj);
 
@@ -225,6 +240,13 @@ private:
     // The server the last fix came from: a fix from one is not handed out
     // as the answer of the other after setNetworkProvider.
     NetworkLocationBackend mFixBackend;
+    // Location sharing: the call to the account service, its time limit,
+    // when it last gave a position, and a manual answer that waits for it.
+    LSMessageToken mRelayToken;
+    guint mRelayTimeoutId;
+    bool mRelayPending;
+    int64_t mRelayFixAt;
+    bool mManualWaiting;
 };
 
 
diff --git a/src/handler/position/network/NetworkLocationBackend.cpp b/src/handler/position/network/NetworkLocationBackend.cpp
index 8c284a0..c62071c 100644
--- a/src/handler/position/network/NetworkLocationBackend.cpp
+++ b/src/handler/position/network/NetworkLocationBackend.cpp
@@ -139,6 +139,58 @@ bool parseManualPosition(const char *json, ManualPosition *out) {
     return ok;
 }
 
+bool parseRelayPosition(const char *reply, RelayPosition *out) {
+    if (!reply || !*reply || !out)
+        return false;
+    JSchemaInfo schemaInfo;
+    jschema_info_init(&schemaInfo, jschema_all(), NULL, NULL);
+    jvalue_ref parsed = jdom_parse(j_cstr_to_buffer(reply), DOMOPT_NOOPT, &schemaInfo);
+    if (jis_null(parsed) || !jis_object(parsed)) {
+        if (!jis_null(parsed))
+            j_release(&parsed);
+        return false;
+    }
+    RelayPosition position;
+    jvalue_ref ok = NULL, pos = NULL;
+    bool returned = false;
+    bool good = jobject_get_exists(parsed, J_CSTR_TO_BUF("returnValue"), &ok) && jis_boolean(ok)
+                && jboolean_get(ok, &returned) == CONV_OK && returned
+                && jobject_get_exists(parsed, J_CSTR_TO_BUF("position"), &pos) && jis_object(pos)
+                && numberField(pos, "latitude", &position.latitude)
+                && numberField(pos, "longitude", &position.longitude)
+                && position.latitude >= -90 && position.latitude <= 90
+                && position.longitude >= -180 && position.longitude <= 180
+                && !(position.latitude == 0 && position.longitude == 0);
+    if (good) {
+        if (!numberField(pos, "accuracy", &position.accuracy) || !(position.accuracy > 0))
+            position.accuracy = 100;
+        if (position.accuracy < 1)
+            position.accuracy = 1;
+        if (position.accuracy > 100000)
+            position.accuracy = 100000;
+        if (!numberField(pos, "age", &position.age) || position.age < 0)
+            position.age = 0;
+        double value;
+        if (numberField(pos, "altitude", &value))
+            position.altitude = value;
+        if (numberField(pos, "heading", &value) && value >= 0 && value <= 360)
+            position.heading = value;
+        if (numberField(pos, "speed", &value) && value >= 0)
+            position.speed = value;
+        jvalue_ref source = NULL, name = NULL;
+        if (jobject_get_exists(pos, J_CSTR_TO_BUF("source"), &source) && jis_object(source)
+            && jobject_get_exists(source, J_CSTR_TO_BUF("name"), &name) && jis_string(name)) {
+            raw_buffer buf = jstring_get(name);
+            position.source.assign(buf.m_str, buf.m_len < 100 ? buf.m_len : 100);
+            jstring_free_buffer(buf);
+        }
+        position.set = true;
+        *out = position;
+    }
+    j_release(&parsed);
+    return good;
+}
+
 std::string manualPositionJson(const ManualPosition &position) {
     jvalue_ref obj = jobject_create();
     jobject_put(obj, J_CSTR_TO_JVAL("latitude"), jnumber_create_f64(position.latitude));
