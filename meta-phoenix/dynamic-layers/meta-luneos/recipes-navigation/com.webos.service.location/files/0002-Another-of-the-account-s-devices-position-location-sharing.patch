 #define IP_FALLBACK_DELAY_S                    4
 #define IP_QUERY_INTERVAL_MS                   (10 * 60 * 1000)
+/* Location sharing: how long the account service may take to answer, and
+ * how long its last position keeps the Wi-Fi, cell and IP queries back
+ * (it is asked again every minute while a request runs). */
+#define RELAY_TIMEOUT_MS                       3000
+#define RELAY_HOLD_MS                          (150 * 1000)
 
 static int64_t nowMs() {
     struct timeval tv;
@@ -60,6 +65,11 @@ NetworkPositionProvider::NetworkPositionProvider(LSHandle *sh) : PositionProvide
     mIpFallbackId = 0;
     mLastIpQuery = 0;
     mFixBackend = NetworkLocationBackend::BeaconDB;
+    mRelayToken = LSMESSAGE_TOKEN_INVALID;
+    mRelayTimeoutId = 0;
+    mRelayPending = false;
+    mRelayFixAt = 0;
+    mManualWaiting = false;
 }
 
 /*
@@ -150,6 +160,98 @@ gboolean NetworkPositionProvider::manualReplyCb(gpointer obj) {
     return G_SOURCE_REMOVE;
 }
 
+bool NetworkPositionProvider::relayFresh() const {
+    return mRelayFixAt != 0 && nowMs() - mRelayFixAt < RELAY_HOLD_MS;
+}
+
+void NetworkPositionProvider::askRelay() {
+    if (mRelayPending)
+        return;
+    LSError lserror;
+    LSErrorInit(&lserror);
+    mRelayToken = LSMESSAGE_TOKEN_INVALID;
+    if (!LSCallOneReply(mLSHandle, RELAY_POSITION_METHOD, "{}", relayCb, this, &mRelayToken, &lserror)) {
+        // No account service (a build without it): as if it had no position.
+        LS_LOG_DEBUG("askRelay: %s", lserror.message ? lserror.message : "LSCall failed");
+        LSErrorFree(&lserror);
+        relayAnswered(NULL);
+        return;
+    }
+    mRelayPending = true;
+    if (mRelayTimeoutId)
+        g_source_remove(mRelayTimeoutId);
+    mRelayTimeoutId = g_timeout_add(RELAY_TIMEOUT_MS, &relayTimeoutCb, (gpointer) this);
+}
+
+bool NetworkPositionProvider::relayCb(LSHandle *sh, LSMessage *reply, void *ctx) {
+    NetworkPositionProvider *pThis = static_cast<NetworkPositionProvider *>(ctx);
+    if (!pThis)
+        return true;
+    pThis->mRelayPending = false;
+    pThis->mRelayToken = LSMESSAGE_TOKEN_INVALID;
+    if (pThis->mRelayTimeoutId) {
+        g_source_remove(pThis->mRelayTimeoutId);
+        pThis->mRelayTimeoutId = 0;
+    }
+    RelayPosition position;
+    if (parseRelayPosition(LSMessageGetPayload(reply), &position))
+        pThis->relayAnswered(&position);
+    else
+        pThis->relayAnswered(NULL);
+    return true;
+}
+
+/* The account service did not answer in time: go on without it (a reply
+ * that comes later is still used). */
+gboolean NetworkPositionProvider::relayTimeoutCb(gpointer obj) {
+    NetworkPositionProvider *pThis = static_cast<NetworkPositionProvider *>(obj);
+    if (!pThis)
+        return G_SOURCE_REMOVE;
+    pThis->mRelayTimeoutId = 0;
+    LS_LOG_INFO("locationRelay: no answer in %d ms", RELAY_TIMEOUT_MS);
+    if (pThis->mManualWaiting) {
+        pThis->mManualWaiting = false;
+        manualReplyCb(obj);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+void NetworkPositionProvider::relayAnswered(const RelayPosition *position) {
+    bool waiting = mManualWaiting;
+    mManualWaiting = false;
+    if (!position) {
+        mRelayFixAt = 0;
+        if (waiting)
+            manualReplyCb((gpointer) this);
+        return;
+    }
+    int64_t now = nowMs();
+    int64_t measured = now - (int64_t) (position->age * 1000);
+    mRelayFixAt = now;
+    if (!mProcessRequestInProgress && !waiting)
+        return;   // nobody asked any more; kept as "fresh" for the next request
+    if (!waiting && position->latitude == mPositionData.lastLatitude && position->longitude == mPositionData.lastLongitude
+        && position->accuracy == mPositionData.lastAccuracy && mFixBackend == currentBackend()) {
+        LS_LOG_DEBUG("locationRelay: no position change");
+        mPositionData.lastTimeStamp = measured;
+        return;
+    }
+    LS_LOG_INFO("locationRelay: a position from %s, %.0f m, %.0f s old",
+                position->source.empty() ? "another device" : position->source.c_str(), position->accuracy, position->age);
+    mPositionData.lastLatitude = position->latitude;
+    mPositionData.lastLongitude = position->longitude;
+    mPositionData.lastAccuracy = position->accuracy;
+    mPositionData.lastTimeStamp = measured;
+    mFixBackend = currentBackend();
+    set_store_position(measured, position->latitude, position->longitude, position->altitude, position->speed,
+                       position->heading, position->accuracy, INVALID_PARAM, (LOCATION_DB_PREF_PATH_NETWORK));
+    if (getCallback()) {
+        GeoLocation geoLocation(position->latitude, position->longitude, position->altitude, position->accuracy, measured,
+                                position->heading, -1.0, position->speed, -1.0);
+        getCallback()->getLocationUpdateCb(geoLocation, ERROR_NONE, HANDLER_NETWORK);
+    }
+}
