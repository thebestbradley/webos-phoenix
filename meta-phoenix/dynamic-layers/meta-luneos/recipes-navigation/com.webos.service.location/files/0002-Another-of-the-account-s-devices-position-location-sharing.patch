+// Another of the account's devices' position (location sharing) answers a
+// running request with its own accuracy and the time it was measured, holds
+// back the IP query, and is let go when the account service has none.
+static void test_relay_position_answers_the_request(void) {
+    NetworkPositionProvider provider(NULL);
+    FakeCallbacks callbacks;
+    provider.setCallback(&callbacks);
+    NetworkPositionProviderTest::startRequest(provider);
+    RelayPosition relay;
+    relay.set = true;
+    relay.latitude = 51.5007;
+    relay.longitude = -0.1246;
+    relay.accuracy = 8;
+    relay.age = 10;
+    relay.source = "iPad";
+    int64_t before = g_get_real_time() / 1000;
+
+    NetworkPositionProviderTest::relayAnswer(provider, &relay);
+
+    g_assert_cmpint(callbacks.calls, ==, 1);
+    g_assert_cmpint(callbacks.lastError, ==, ERROR_NONE);
+    g_assert_cmpfloat(callbacks.last.getLatitude(), ==, 51.5007);
+    g_assert_cmpfloat(callbacks.last.getHorizontalAccuracy(), ==, 8);
+    int64_t measured = NetworkPositionProviderTest::lastTimeStamp(provider);
+    g_assert_cmpint(measured, <=, before - 9000);
+    g_assert_cmpint(measured, >=, before - 11000);
+    g_assert_true(NetworkPositionProviderTest::relayFresh(provider));
+
+    // The same again a minute later: nothing new to tell.
+    NetworkPositionProviderTest::relayAnswer(provider, &relay);
+    g_assert_cmpint(callbacks.calls, ==, 1);
+
+    NetworkPositionProviderTest::relayAnswer(provider, NULL);
+    g_assert_false(NetworkPositionProviderTest::relayFresh(provider));
+    g_assert_cmpint(callbacks.calls, ==, 1);
+}
+
+// With no request running (a one-off request answered and stopped), a late
+// answer tells nobody.
+static void test_relay_position_without_a_request(void) {
+    NetworkPositionProvider provider(NULL);
+    FakeCallbacks callbacks;
+    provider.setCallback(&callbacks);
+    RelayPosition relay;
+    relay.set = true;
+    relay.latitude = 1;
+    relay.longitude = 2;
+    relay.accuracy = 5;
+
+    NetworkPositionProviderTest::relayAnswer(provider, &relay);
+
+    g_assert_cmpint(callbacks.calls, ==, 0);
+}
+
