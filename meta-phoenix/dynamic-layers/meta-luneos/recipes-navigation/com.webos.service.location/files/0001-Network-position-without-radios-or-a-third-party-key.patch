+static bool sManualLoaded = false;
+static ManualPosition sManual;
+
+ManualPosition NetworkPositionProvider::manualPosition() {
+    if (sManualLoaded)
+        return sManual;
+
+    LPAppHandle lpHandle = 0;
+    char *json = NULL;
+
+    if (LPAppGetHandle(NETWORK_BACKEND_PREF_APP, &lpHandle) == LP_ERR_NONE) {
+        if (LPAppCopyValueString(lpHandle, MANUAL_POSITION_PREF, &json) != LP_ERR_NONE)
+            json = NULL;
+        LPAppFreeHandle(lpHandle, false);
+    }
+
+    sManual = ManualPosition();
+    parseManualPosition(json, &sManual);
+    sManualLoaded = true;
+    g_free(json);
+    return sManual;
+}
+
+bool NetworkPositionProvider::storeManualPosition(const ManualPosition &position) {
+    LPAppHandle lpHandle = 0;
+
+    if (LPAppGetHandle(NETWORK_BACKEND_PREF_APP, &lpHandle) != LP_ERR_NONE)
+        return false;
+    LPErr written = LPAppSetValueString(lpHandle, MANUAL_POSITION_PREF, manualPositionJson(position).c_str());
+    LPAppFreeHandle(lpHandle, true);
+    if (written != LP_ERR_NONE)
+        return false;
+
+    sManual = position;
+    sManualLoaded = true;
+    return true;
+}
+
+/* A request while the position is the user's: answered from the main loop,
+ * after getLocationUpdates has put the request in its table. */
+gboolean NetworkPositionProvider::manualReplyCb(gpointer obj) {
+    NetworkPositionProvider *pThis = static_cast<NetworkPositionProvider *>(obj);
+    ManualPosition manual = manualPosition();
+
+    if (!pThis || !manual.set || !pThis->getCallback())
+        return G_SOURCE_REMOVE;
+
+    int64_t now = nowMs();
+    set_store_position(now, manual.latitude, manual.longitude, INVALID_PARAM, INVALID_PARAM, INVALID_PARAM,
+                       manual.accuracy, INVALID_PARAM, (LOCATION_DB_PREF_PATH_NETWORK));
+    GeoLocation geoLocation(manual.latitude, manual.longitude, -1.0, manual.accuracy, now, -1.0, -1.0, -1.0, -1.0);
+    pThis->getCallback()->getLocationUpdateCb(geoLocation, ERROR_NONE, HANDLER_NETWORK);
+    return G_SOURCE_REMOVE;
+}
+
+/* No Wi-Fi or cell data came in time (a VM, a tablet on a wired network, a
+ * phone without a SIM): the server places the device by its address. */
+gboolean NetworkPositionProvider::ipFallbackCb(gpointer obj) {
+    NetworkPositionProvider *pThis = static_cast<NetworkPositionProvider *>(obj);
+
+    if (!pThis)
+        return G_SOURCE_REMOVE;
+    pThis->mIpFallbackId = 0;
+    if (pThis->mProcessRequestInProgress && pThis->mPositionData.lastTimeStamp == 0)
+        pThis->postIpQueryIfDue();
+    return G_SOURCE_REMOVE;
+}
+
+bool NetworkPositionProvider::postIpQueryIfDue() {
+    int64_t now = nowMs();
+
+    if (mPositionData.lastTimeStamp != 0 && mLastIpQuery != 0 && now - mLastIpQuery < IP_QUERY_INTERVAL_MS) {
+        LS_LOG_DEBUG("postIpQueryIfDue: asked %lld ms ago", (long long) (now - mLastIpQuery));
+        return false;
+    }
+
+    char query[] = IP_ONLY_GEOLOCATE_QUERY;
+    LS_LOG_INFO("no Wi-Fi or cell data: asking for a position by IP address");
+    if (!networkPostQuery(query, mPositionData.nwGeolocationKey, FALSE))
+        return false;
+    mLastIpQuery = now;
+    return true;
+}
