+
+static bool numberField(jvalue_ref obj, const char *name, double *out) {
+    jvalue_ref value = NULL;
+    if (!jobject_get_exists(obj, j_cstr_to_buffer(name), &value) || !jis_number(value))
+        return false;
+    return jnumber_get_f64(value, out) == CONV_OK;
+}
+
+bool parseManualPosition(const char *json, ManualPosition *out) {
+    if (!json || !*json || !out)
+        return false;
+    JSchemaInfo schemaInfo;
+    jschema_info_init(&schemaInfo, jschema_all(), NULL, NULL);
+    jvalue_ref parsed = jdom_parse(j_cstr_to_buffer(json), DOMOPT_NOOPT, &schemaInfo);
+    if (jis_null(parsed) || !jis_object(parsed)) {
+        if (!jis_null(parsed))
+            j_release(&parsed);
+        return false;
+    }
+    ManualPosition position;
+    bool ok = numberField(parsed, "latitude", &position.latitude)
+              && numberField(parsed, "longitude", &position.longitude)
+              && position.latitude >= -90 && position.latitude <= 90
+              && position.longitude >= -180 && position.longitude <= 180;
+    if (ok) {
+        if (!numberField(parsed, "accuracy", &position.accuracy) || !(position.accuracy > 0))
+            position.accuracy = MANUAL_POSITION_DEFAULT_ACCURACY;
+        if (position.accuracy < 10)
+            position.accuracy = 10;
+        if (position.accuracy > 100000)
+            position.accuracy = 100000;
+        jvalue_ref name = NULL;
+        if (jobject_get_exists(parsed, J_CSTR_TO_BUF("name"), &name) && jis_string(name)) {
+            raw_buffer buf = jstring_get(name);
+            position.name.assign(buf.m_str, buf.m_len < 100 ? buf.m_len : 100);
+            jstring_free_buffer(buf);
+        }
+        position.set = true;
+        *out = position;
+    }
+    j_release(&parsed);
+    return ok;
+}
+
+std::string manualPositionJson(const ManualPosition &position) {
+    jvalue_ref obj = jobject_create();
+    jobject_put(obj, J_CSTR_TO_JVAL("latitude"), jnumber_create_f64(position.latitude));
+    jobject_put(obj, J_CSTR_TO_JVAL("longitude"), jnumber_create_f64(position.longitude));
+    jobject_put(obj, J_CSTR_TO_JVAL("accuracy"), jnumber_create_f64(position.accuracy));
+    jobject_put(obj, J_CSTR_TO_JVAL("name"), jstring_create_copy(j_str_to_buffer(position.name.c_str(), position.name.size())));
+    std::string json = jvalue_tostring_simple(obj);
+    j_release(&obj);
+    return json;
 }
 
