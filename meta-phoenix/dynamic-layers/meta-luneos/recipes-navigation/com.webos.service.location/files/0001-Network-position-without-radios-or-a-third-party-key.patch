+// webOS Phoenix: the platform's own geolocate service, from
+// /etc/location/geolocate.conf, is the default when it is configured.
+static void test_phoenix_service_from_config(void) {
+    gchar *path = NULL;
+    gint fd = g_file_open_tmp("geolocate-XXXXXX.conf", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+
+    setPhoenixGeolocateConfPath("/nonexistent/geolocate.conf");
+    g_assert_null(phoenixGeolocateUrl());
+    g_assert_true(defaultNetworkLocationBackend() == NetworkLocationBackend::BeaconDB);
+    g_assert_true(parseNetworkLocationBackend("phoenix") == NetworkLocationBackend::BeaconDB);
+
+    g_assert_true(g_file_set_contents(path, "[geolocate]\nurl= https://example.org/v1/location/geolocate \n", -1, NULL));
+    setPhoenixGeolocateConfPath(path);
+    g_assert_cmpstr(phoenixGeolocateUrl(), ==, "https://example.org/v1/location/geolocate");
+    g_assert_true(defaultNetworkLocationBackend() == NetworkLocationBackend::Phoenix);
+    g_assert_true(parseNetworkLocationBackend(NULL) == NetworkLocationBackend::Phoenix);
+    g_assert_true(parseNetworkLocationBackend("beacondb") == NetworkLocationBackend::BeaconDB);
+    g_assert_cmpstr(networkLocationBackendName(NetworkLocationBackend::Phoenix), ==, "phoenix");
+    char url[256];
+    g_assert_true(buildGeolocateUrl(networkLocationBackendUrl(NetworkLocationBackend::Phoenix), NULL, url, sizeof(url)));
+    g_assert_cmpstr(url, ==, "https://example.org/v1/location/geolocate");
+
+    // Not an http(s) address, or one with a template slot: none.
+    g_assert_true(g_file_set_contents(path, "[geolocate]\nurl=https://example.org/%s\n", -1, NULL));
+    setPhoenixGeolocateConfPath(path);
+    g_assert_null(phoenixGeolocateUrl());
+    g_assert_true(g_file_set_contents(path, "[geolocate]\nurl=file:///etc/passwd\n", -1, NULL));
+    setPhoenixGeolocateConfPath(path);
+    g_assert_null(phoenixGeolocateUrl());
+
+    setPhoenixGeolocateConfPath(NULL);
+    g_unlink(path);
+    g_free(path);
+}
+
+static void test_manual_position(void) {
+    ManualPosition p;
+    g_assert_true(parseNetworkLocationBackend("manual") == NetworkLocationBackend::Manual);
+    g_assert_null(networkLocationBackendUrl(NetworkLocationBackend::Manual));
+
+    g_assert_true(parseManualPosition("{\"latitude\":30.27,\"longitude\":-97.74,\"name\":\"Austin, Texas\"}", &p));
+    g_assert_true(p.set);
+    g_assert_cmpfloat(p.latitude, ==, 30.27);
+    g_assert_cmpfloat(p.longitude, ==, -97.74);
+    g_assert_cmpfloat(p.accuracy, ==, MANUAL_POSITION_DEFAULT_ACCURACY);
+    g_assert_cmpstr(p.name.c_str(), ==, "Austin, Texas");
+
+    ManualPosition again;
+    g_assert_true(parseManualPosition(manualPositionJson(p).c_str(), &again));
+    g_assert_cmpfloat(again.latitude, ==, p.latitude);
+    g_assert_cmpstr(again.name.c_str(), ==, p.name.c_str());
+
+    g_assert_true(parseManualPosition("{\"latitude\":0,\"longitude\":0,\"accuracy\":1}", &p));
+    g_assert_cmpfloat(p.accuracy, ==, 10);
+    g_assert_true(parseManualPosition("{\"latitude\":0,\"longitude\":0,\"accuracy\":1e9}", &p));
+    g_assert_cmpfloat(p.accuracy, ==, 100000);
+
+    ManualPosition untouched;
+    g_assert_false(parseManualPosition(NULL, &untouched));
+    g_assert_false(parseManualPosition("", &untouched));
+    g_assert_false(parseManualPosition("not json", &untouched));
+    g_assert_false(parseManualPosition("{\"latitude\":91,\"longitude\":0}", &untouched));
+    g_assert_false(parseManualPosition("{\"latitude\":\"30\",\"longitude\":0}", &untouched));
+    g_assert_false(parseManualPosition("{\"longitude\":0}", &untouched));
+    g_assert_false(untouched.set);
+}
