+void setPhoenixGeolocateConfPath(const char *path) {
+    sGeolocateConfPath = path ? path : PHOENIX_GEOLOCATE_CONF;
+    sGeolocateUrlRead = false;
+    sGeolocateUrl.clear();
+}
+
+const char *phoenixGeolocateUrl() {
+    if (!sGeolocateUrlRead) {
+        sGeolocateUrlRead = true;
+        GKeyFile *file = g_key_file_new();
+        if (g_key_file_load_from_file(file, sGeolocateConfPath.c_str(), G_KEY_FILE_NONE, NULL)) {
+            gchar *url = g_key_file_get_string(file, "geolocate", "url", NULL);
+            if (url) {
+                g_strstrip(url);
+                // Only a plain https (or, for a test server, http) address:
+                // it is used as a template, so no "%".
+                if ((g_str_has_prefix(url, "https://") || g_str_has_prefix(url, "http://"))
+                    && !strchr(url, '%') && strlen(url) < 200)
+                    sGeolocateUrl = url;
+                g_free(url);
+            }
+        }
+        g_key_file_free(file);
+    }
+    return sGeolocateUrl.empty() ? NULL : sGeolocateUrl.c_str();
+}
+
+NetworkLocationBackend defaultNetworkLocationBackend() {
+    return phoenixGeolocateUrl() ? NetworkLocationBackend::Phoenix : NetworkLocationBackend::BeaconDB;
+}
