-    return backend == NetworkLocationBackend::Google ? GOOGLE_GEOLOCATE_URL : BEACONDB_GEOLOCATE_URL;
+    switch (backend) {
+        case NetworkLocationBackend::Google: return GOOGLE_GEOLOCATE_URL;
+        case NetworkLocationBackend::Phoenix: return phoenixGeolocateUrl();
+        case NetworkLocationBackend::Manual: return NULL;
+        default: return BEACONDB_GEOLOCATE_URL;
+    }
