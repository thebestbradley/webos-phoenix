#
# settingsservice's descriptions of Phoenix's keys, in its own store.
# The drop-in file (/etc/palm/settings/defaults/phoenix.description.json)
# is read at its start, but a set is checked against the descriptions in
# its db8 store too, which only setSystemSettingDesc fills (2.0 Revision 37:
# the drop-in alone still answered errorKey for picture.backlight). Run at
# each boot; setting the same description again changes nothing.
FILE=/etc/palm/settings/defaults/phoenix.description.json
[ -r "$FILE" ] || exit 0
python3 - "$FILE" <<'PY'
import json, subprocess, sys, time
for d in json.load(open(sys.argv[1])):
    desc = {k: d[k] for k in ("category", "key", "ui", "vtype", "values", "volatile", "valueCheck") if k in d}
    for attempt in range(30):
        out = subprocess.run(["luna-send", "-n", "1", "-w", "10000", "luna://com.webos.settingsservice/setSystemSettingDesc",
                              json.dumps(desc)], capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout
        if '"returnValue":true' in out.replace(" ", ""):
            print("described %s.%s" % (d["category"], d["key"]))
            break
        time.sleep(2)
    else:
        print("could not describe %s.%s: %s" % (d["category"], d["key"], out.strip()), file=sys.stderr)
PY
