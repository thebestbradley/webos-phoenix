# Sourced by luna-surfacemanager's surface-manager.sh before it starts the
# compositor. Point the compositor at the Phoenix QML: its WebOSCompositor
# module overrides ViewsRoot with the Phoenix shell.
export WEBOS_COMPOSITOR_IMPORT_PATH=/usr/share/phoenix/qml

# The shell reads its start-up preferences (Settings > Advanced's start-up
# animation, the rotation lock) from a file before its first frame
# (LsmSystemStatus, /var/lib/phoenix/systemmanager/startup.json, written by
# services/systemmanager): QML's XMLHttpRequest reads local files only with
# this set.
export QML_XHR_ALLOW_FILE_READ=1

# Phones and tablets are touch-first.
export WEBOS_CURSOR_HIDE=1

# The output's geometry for this device (phoenix-device-config, per
# MACHINE: e.g. WEBOS_COMPOSITOR_GEOMETRY=720x1440+0+0r0s1 on a PinePhone).
# surface-manager.sh has already read com.webos.surfacemanager.
# compositorGeometry by now; a machine's file overrides it.
if [ -f /etc/phoenix/compositor.env ]; then
    . /etc/phoenix/compositor.env
fi
