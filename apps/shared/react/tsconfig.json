{
  // @phoenix/sdk from its sources, so the workspace typechecks before
  // anything is built (vitest.config.ts aliases it the same).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@phoenix/sdk": ["../sdk/src/index.ts"],
      "@phoenix/sdk/testing": ["../sdk/src/testing.ts"]
    }
  },
  "include": ["src"]
}
