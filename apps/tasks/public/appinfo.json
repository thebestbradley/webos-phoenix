{
    "id": "org.webosphoenix.tasks",
    "version": "0.1.0",
    "vendor": "webOS Phoenix",
    "type": "web",
    "main": "index.html",
    "title": "Tasks",
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "largeIcon": "icon-128x128.png",
    "extraLargeIcon": "icon-512x512.png",
    "iconColor": "#3b8fd6",
    "uiRevision": 2,
    "keywords": ["To-do", "Todo", "Reminders", "Checklist"],
    "phoenix": {
        "//": "Phoenix launcher metadata (docs/APP-RUNTIME.md): launcherTab 0 = Apps, 1 = Downloads, 2 = Settings.",
        "launchParams": ["taskId", "fromReminder", "text", "reminder"],
        "launcherTab": 0
    },
    "universalSearch": {
        "action": {
            "displayName": "New Task",
            "url": "org.webosphoenix.tasks",
            "launchParam": "text"
        },
        "dbsearch": {
            "displayName": "Tasks",
            "url": "org.webosphoenix.tasks",
            "launchParam": "taskId",
            "launchParamDbField": "_id",
            "displayFields": ["summary", {
                "name": "due",
                "type": "timestamp"
            }],
            "dbQuery": {
                "from": "com.palm.task:1",
                "where": [
                    {
                        "prop": "summary",
                        "op": "?",
                        "val": "",
                        "collate": "primary"
                    }
                ],
                "orderBy": "summary",
                "desc": false,
                "limit": 20
            }
        }
    }
}
