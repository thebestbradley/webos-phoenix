{
    "id": "org.webosphoenix.todoist",
    "version": "0.1.0",
    "vendor": "webOS Phoenix",
    "type": "web",
    "main": "index.html",
    "title": "Todoist",
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "largeIcon": "icon-128x128.png",
    "extraLargeIcon": "icon-512x512.png",
    "uiRevision": 2,
    "phoenix": {
        "//": "Not in the launcher: the app carries the Todoist account (accounts/wizard.html, the template in public/accounts, the service) and the share sheet's Add to Todoist page (index.html, the kit's compose page). A connector package of Phoenix's own, installed from the catalog's Connections (docs/SYNERGY-CONNECTORS.md 7). shareTargets is written from the definition's share (service/connector.js).",
        "hidden": true,
        "shareTargets": [
            {
                "types": [
                    "text/plain",
                    "text/uri-list"
                ],
                "label": "Add to Todoist",
                "connector": {
                    "templateId": "com.webosphoenix.todoist",
                    "service": "org.webosphoenix.service.todoist",
                    "accepts": {
                        "text": {
                            "maxLength": 16384
                        },
                        "link": true
                    }
                }
            }
        ]
    },
    "requiredPermissions": [
        "accounts.transport",
        "todoist.account",
        "phoenix.appmanager.launch"
    ]
}
