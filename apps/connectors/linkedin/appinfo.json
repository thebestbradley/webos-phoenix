{
    "id": "org.webosphoenix.linkedin",
    "version": "0.1.0",
    "vendor": "webOS Phoenix",
    "type": "web",
    "main": "index.html",
    "title": "LinkedIn",
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "largeIcon": "icon-128x128.png",
    "extraLargeIcon": "icon-512x512.png",
    "uiRevision": 2,
    "phoenix": {
        "//": "Not in the launcher: the app carries the LinkedIn account (accounts/wizard.html, the template in public/accounts, the service) and its page (index.html: the kit's compose page for Share on LinkedIn, and the import of the data export's Connections.csv). A connector package of Phoenix's own, installed from the catalog's Connections (docs/SYNERGY-CONNECTORS.md 7); its sign-in needs Phoenix's LinkedIn app and the token relay (docs/DEVELOPER-APPS.md).",
        "hidden": true,
        "shareTargets": [
            {
                "types": [
                    "text/plain",
                    "text/uri-list"
                ],
                "label": "LinkedIn",
                "connector": {
                    "templateId": "com.webosphoenix.linkedin",
                    "service": "org.webosphoenix.service.linkedin",
                    "accepts": {
                        "text": {
                            "maxLength": 3000
                        },
                        "link": true
                    },
                    "audience": {
                        "label": "Who can see it",
                        "options": [
                            {
                                "value": "PUBLIC",
                                "label": "Anyone",
                                "hint": "Anyone on or off LinkedIn."
                            },
                            {
                                "value": "CONNECTIONS",
                                "label": "Connections",
                                "hint": "Your connections only."
                            }
                        ],
                        "default": "PUBLIC"
                    }
                }
            }
        ]
    },
    "requiredPermissions": [
        "accounts.transport",
        "linkedin.account",
        "phoenix.appmanager.launch"
    ]
}
