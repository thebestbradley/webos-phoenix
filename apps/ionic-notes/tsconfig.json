{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // notes-core and the Phoenix service plugin from their sources (their
    // dist/ and lib/ are built for publishing and the Enact apps, which
    // are separate npm projects; vite.config.ts aliases them the same).
    "paths": {
      "@phoenix/notes-core": ["../shared/notes-core/src/index.ts"],
      "@phoenix/sdk": ["../shared/sdk/src/index.ts"],
      "@phoenix/react": ["../shared/react/src/index.ts"],
      "@phoenix/capacitor": ["../shared/capacitor/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
