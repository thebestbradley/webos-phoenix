{
    "id": "org.webosphoenix.music",
    "version": "0.1.0",
    "vendor": "webOS Phoenix",
    "type": "web",
    "main": "index.html",
    "title": "Music",
    "icon": "icon.png",
    "splashicon": "icon-256x256.png",
    "largeIcon": "icon-128x128.png",
    "extraLargeIcon": "icon-512x512.png",
    "iconColor": "#e07a1f",
    "uiRevision": 2,
    "phoenix": {
        "//": "shareTargets: what it takes from the share sheet (docs/SHARE-AND-FILES.md): audio, which it plays (a voice memo from Voice Memos' Share).",
        "shareTargets": [
            { "types": ["audio/*"], "label": "Music" }
        ]
    },
    "//requiredPermissions": "OSE access control groups for the services the app calls (the groups in each service's sysbus api.json).",
    "requiredPermissions": [
        "application.launcher",
        "application.operation",
        "mediaindexer.operation",
        "media.operation",
        "audio.operation",
        "phoenix.system.media"
    ]
}
