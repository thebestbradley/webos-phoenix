{
    "about": "Everything connected through Synergy (docs/AI-AND-MCP.md \"The Assistant and Synergy\"): messages on every messaging account, calendars, meetings and invitations, task lists, email accounts, posting, drives and the accounts themselves, in the world of apps/assistant/service/test/accounts-world.cjs (Slack, Bluesky, the Fediverse, Jabber, Unofficial Telegram, Google, Microsoft named Work, Zoom, Todoist, Dropbox, Google Drive, LinkedIn, two email accounts). Outward actions are read back naming the account, and asked about when several accounts fit.",
    "cases": [
        { "id": "b-msg-01", "cat": "synergy messages", "say": "text Sam on Slack: running five minutes late",
          "expect": { "command": "text", "args": { "via": "slack", "message": "running five minutes late", "chat": { "service": "type_slack", "addr": "sam@Northwind" } }, "status": "pending" },
          "text": "on slack\\?$" },
        { "id": "b-msg-02", "cat": "synergy messages", "turns": [
            { "say": "text Sam on Slack: running five minutes late", "expect": { "command": "text", "status": "pending" } },
            { "say": "yes", "expect": { "command": "text", "status": "done" }, "text": "sent to sam delgado on slack" } ] },
        { "id": "b-msg-03", "cat": "synergy messages", "say": "message the #design channel on slack: love the mock-ups",
          "expect": { "command": "text", "args": { "chat": { "service": "type_slack", "addr": "#design@Northwind" } }, "status": "pending" }, "text": "#design on slack" },
        { "id": "b-msg-04", "cat": "synergy messages", "say": "text Kai see you at the stand-up",
          "expect": { "command": "text", "status": "ask" }, "forbid": ["text"], "text": "slack or jabber" },
        { "id": "b-msg-05", "cat": "synergy messages", "turns": [
            { "say": "text Kai see you at the stand-up", "expect": { "command": "text", "status": "ask" } },
            { "say": "Jabber", "expect": { "command": "text", "args": { "chat": { "service": "type_jabber", "addr": "kai@chat.example" } }, "status": "pending" } } ] },
        { "id": "b-msg-06", "cat": "synergy messages", "say": "text Noor running late",
          "expect": { "command": "text", "args": { "chat": { "service": "type_telegram", "addr": "+13035550150" } }, "status": "pending" }, "text": "telegram" },
        { "id": "b-msg-07", "cat": "synergy messages", "say": "text Sam on Signal: hi", "expect": { "answer": "fallback" }, "forbid": ["text"], "text": "can't reach signal" },
        { "id": "b-msg-08", "cat": "synergy messages", "say": "message Priya on Matrix: hi", "expect": { "answer": "fallback" }, "forbid": ["text"], "text": "not signed in to matrix" },
        { "id": "b-msg-09", "cat": "synergy messages", "say": "read my unread slack messages",
          "expect": { "command": "readMessages", "args": { "via": "slack", "unread": true } }, "text": "2 new slack messages" },
        { "id": "b-msg-10", "cat": "synergy messages", "say": "what did Sam say on slack",
          "expect": { "command": "readMessages", "args": { "who": "sam", "via": "slack" } }, "text": "release notes" },
        { "id": "b-msg-11", "cat": "synergy messages", "say": "any new messages on telegram", "expect": { "command": "readMessages", "args": { "via": "telegram" } }, "text": "no new" },
        { "id": "b-msg-12", "cat": "synergy messages", "say": "send a jabber message to Priya saying running late",
          "expect": { "command": "text", "args": { "chat": { "service": "type_jabber", "addr": "priya@chat.example" } }, "status": "pending" } },
        { "id": "b-msg-13", "cat": "synergy messages", "say": "text Sam I'm on my way",
          "expect": { "command": "text", "args": { "chat": null, "message": "I'm on my way" }, "status": "pending" }, "notText": "slack" },
        { "id": "b-msg-14", "cat": "synergy messages", "say": "read my new messages", "expect": { "command": "readMessages", "args": { "unread": true } }, "text": "3 new messages.*slack" },

        { "id": "b-cal-01", "cat": "synergy calendar", "say": "what's on my work calendar tomorrow", "expect": { "command": "agenda", "args": { "calendar": "work" } }, "text": "work calendar.*design review" },
        { "id": "b-cal-02", "cat": "synergy calendar", "say": "what's on my family calendar this week", "expect": { "command": "agenda", "args": { "calendar": "family" } }, "text": "soccer practice" },
        { "id": "b-cal-03", "cat": "synergy calendar", "say": "add lunch with Sam friday at noon to my google calendar",
          "expect": { "command": "event", "args": { "calendar": "google", "title": "Lunch with Sam" } }, "text": "google calendar",
          "effects": [{ "kind": "com.palm.calendarevent.google:1", "where": { "subject": "Lunch with Sam", "calendarId": "cal-google" }, "count": 1 }] },
        { "id": "b-cal-04", "cat": "synergy calendar", "turns": [
            { "say": "add a meeting with Sam tomorrow at 3", "expect": { "command": "event" } },
            { "say": "add it to my google calendar", "expect": { "command": "eventCalendar", "args": { "calendar": "google" } },
              "effects": [{ "kind": "com.palm.calendarevent.google:1", "where": { "subject": "Meeting with Sam" }, "count": 1 },
                          { "kind": "com.palm.calendarevent:1", "where": { "subject": "Meeting with Sam" }, "count": 0 }] } ] },
        { "id": "b-cal-05", "cat": "synergy calendar", "say": "add a call with Zoe tomorrow at 9 to my zoom calendar",
          "expect": { "command": "event", "status": "failed" }, "text": "read only",
          "effects": [{ "kind": "com.palm.calendarevent.zoom:1", "count": 1 }] },
        { "id": "b-cal-06", "cat": "synergy calendar", "say": "join my next meeting", "expect": { "command": "joinMeeting" }, "text": "joining .*weekly sync.* on zoom" },
        { "id": "b-cal-07", "cat": "synergy calendar", "say": "join the design review", "expect": { "command": "joinMeeting", "args": { "query": "design review" } }, "text": "microsoft teams" },
        { "id": "b-cal-08", "cat": "synergy calendar", "say": "accept the invite from alex",
          "expect": { "command": "inviteReply", "args": { "response": "accepted", "eventId": "ev-review" }, "status": "pending" }, "text": "alex will be told" },
        { "id": "b-cal-09", "cat": "synergy calendar", "turns": [
            { "say": "accept the invite from alex", "expect": { "command": "inviteReply", "status": "pending" } },
            { "say": "yes", "expect": { "command": "inviteReply", "status": "done" },
              "effects": [{ "kind": "com.palm.calendarevent.microsoft:1", "where": { "subject": "Design review",
                            "attendees": [{ "email": "alex@example.com" }, { "email": "jordan@northwind.example", "participationStatus": "ACCEPTED" }] }, "count": 1 }] } ] },
        { "id": "b-cal-10", "cat": "synergy calendar", "say": "decline the team offsite",
          "expect": { "command": "inviteReply", "args": { "response": "declined", "eventId": "ev-offsite" }, "status": "pending" }, "text": "priya will be told" },
        { "id": "b-cal-11", "cat": "synergy calendar", "say": "tentatively accept the team offsite",
          "expect": { "command": "inviteReply", "args": { "response": "tentative" }, "status": "pending" }, "text": "say maybe to" },
        { "id": "b-cal-12", "cat": "synergy calendar", "say": "am I free tomorrow at 4 on my work calendar",
          "expect": { "command": "freeTime", "args": { "calendar": "work" } }, "text": "design review" },
        { "id": "b-cal-13", "cat": "synergy calendar", "say": "what's on my google calendar", "expect": { "command": "agenda", "args": { "calendar": "google" } }, "text": "nothing on your google calendar" },

        { "id": "b-task-01", "cat": "synergy tasks", "say": "add milk to my todoist shopping list", "expect": { "command": "task" }, "text": "in todoist",
          "effects": [{ "kind": "com.palm.task.todoist:1", "where": { "summary": "Milk", "listId": "tl-todo-shop", "accountId": "acct-todoist" }, "count": 1 }] },
        { "id": "b-task-02", "cat": "synergy tasks", "say": "add batteries to todoist", "expect": { "command": "task", "args": { "account": "todoist" } },
          "effects": [{ "kind": "com.palm.task.todoist:1", "where": { "summary": "Batteries", "listId": "tl-todo-inbox" }, "count": 1 }] },
        { "id": "b-task-03", "cat": "synergy tasks", "say": "what's on my microsoft to do", "expect": { "command": "taskList", "args": { "account": "microsoft to do" } }, "text": "expense report.*toner" },
        { "id": "b-task-04", "cat": "synergy tasks", "say": "what's on my todoist home list", "expect": { "command": "taskList" }, "text": "fix the gate" },
        { "id": "b-task-05", "cat": "synergy tasks", "say": "put printer paper on my work office list", "expect": { "command": "task" },
          "effects": [{ "kind": "com.palm.task.microsoft:1", "where": { "summary": "Printer paper", "listId": "tl-ms-office" }, "count": 1 }] },
        { "id": "b-task-06", "cat": "synergy tasks", "say": "what are my google tasks", "expect": { "command": "taskList", "args": { "account": "google tasks" } }, "text": "passport" },
        { "id": "b-task-07", "cat": "synergy tasks", "say": "add stamps to my todoist errands list", "expect": { "command": "task", "status": "failed" }, "text": "no list called",
          "effects": [{ "kind": "com.palm.task.todoist:1", "where": { "summary": "Stamps" }, "count": 0 }] },

        { "id": "b-mail-01", "cat": "synergy email", "say": "any new emails in my work account", "expect": { "command": "searchEmail", "args": { "account": "work", "unread": true } },
          "text": "in work mail.*q4 budget review" },
        { "id": "b-mail-02", "cat": "synergy email", "say": "read my latest email in my work account", "expect": { "command": "readEmail", "args": { "account": "work" } }, "text": "hannah" },
        { "id": "b-mail-03", "cat": "synergy email", "turns": [
            { "say": "read my latest email in my work account", "expect": { "command": "readEmail" } },
            { "say": "archive it", "expect": { "command": "emailMark", "args": { "action": "archive" } },
              "effects": [{ "kind": "com.palm.imap.email:1", "where": { "subject": "Q4 budget review", "destFolderId": "fw-archive" }, "count": 1 }] } ] },
        { "id": "b-mail-04", "cat": "synergy email", "say": "mark the email from hannah as read", "expect": { "command": "emailMark", "args": { "action": "read" } },
          "effects": [{ "kind": "com.palm.imap.email:1", "where": { "subject": "Q4 budget review", "flags": { "read": true } }, "count": 1 }] },
        { "id": "b-mail-05", "cat": "synergy email", "say": "flag the email from northwind it", "expect": { "command": "emailMark", "args": { "action": "flag" } },
          "effects": [{ "kind": "com.palm.imap.email:1", "where": { "subject": "Your new badge", "flags": { "flagged": true } }, "count": 1 }] },
        { "id": "b-mail-06", "cat": "synergy email", "say": "delete the email from hannah", "expect": { "command": "emailDelete", "status": "pending" }, "text": "in work mail\\?$" },
        { "id": "b-mail-07", "cat": "synergy email", "turns": [
            { "say": "delete the email from hannah", "expect": { "command": "emailDelete", "status": "pending" } },
            { "say": "no", "expect": { "answer": "chat" }, "forbid": ["emailDelete"],
              "effects": [{ "kind": "com.palm.imap.email:1", "where": { "subject": "Q4 budget review" }, "count": 1 }] } ] },
        { "id": "b-mail-08", "cat": "synergy email", "say": "any new emails in my gmail", "expect": { "answer": "fallback" }, "forbid": ["emailMark"], "text": "google account" },
        { "id": "b-mail-09", "cat": "synergy email", "say": "mark all as read", "expect": { "command": "emailMark", "args": { "action": "read", "all": true } } },

        { "id": "b-post-01", "cat": "synergy posting", "say": "post to bluesky: shipping the new launcher today",
          "expect": { "command": "post", "args": { "text": "shipping the new launcher today", "share": { "accountId": "acct-bluesky" } }, "status": "pending" },
          "text": "as @jordan\\.bsky\\.social" },
        { "id": "b-post-02", "cat": "synergy posting", "turns": [
            { "say": "post to bluesky: shipping the new launcher today", "expect": { "command": "post", "status": "pending" } },
            { "say": "yes", "expect": { "command": "post", "status": "done" }, "text": "posted to bluesky" } ] },
        { "id": "b-post-03", "cat": "synergy posting", "say": "toot hello fediverse", "expect": { "command": "post", "args": { "share": { "accountId": "acct-fedi" } }, "status": "pending" },
          "text": "public" },
        { "id": "b-post-04", "cat": "synergy posting", "turns": [
            { "say": "share this on linkedin", "expect": { "command": "post", "status": "ask" } },
            { "say": "we're hiring a designer", "expect": { "command": "post", "args": { "share": { "accountId": "acct-linkedin" } }, "status": "pending" }, "text": "anyone" } ] },
        { "id": "b-post-05", "cat": "synergy posting", "say": "post: hello everyone", "expect": { "command": "post", "status": "ask" }, "forbid": ["post"], "text": "which account" },
        { "id": "b-post-06", "cat": "synergy posting", "say": "tweet hello", "expect": { "answer": "fallback" }, "forbid": ["post"] },
        { "id": "b-post-07", "cat": "synergy posting", "say": "post on facebook that I'm back from vacation", "expect": { "answer": "fallback" }, "forbid": ["post"] },

        { "id": "b-file-01", "cat": "synergy files", "say": "find the budget file on dropbox", "expect": { "command": "findFiles", "args": { "drive": "dropbox" } }, "text": "budget 2027.*dropbox" },
        { "id": "b-file-02", "cat": "synergy files", "turns": [
            { "say": "find the budget file on dropbox", "expect": { "command": "findFiles" } },
            { "say": "save it to google drive", "expect": { "command": "saveToDrive", "args": { "to": "/media/drives/acct-gdrive/Budget 2027.xlsx" }, "status": "pending" } },
            { "say": "yes", "expect": { "command": "saveToDrive", "status": "done" }, "text": "uploaded" } ] },
        { "id": "b-file-03", "cat": "synergy files", "say": "find the trip itinerary on google drive", "expect": { "command": "findFiles", "args": { "drive": "google drive" } }, "text": "trip itinerary" },
        { "id": "b-file-04", "cat": "synergy files", "say": "upload the budget file to box", "expect": { "answer": "fallback" }, "forbid": ["saveToDrive"], "text": "not signed in to box" },

        { "id": "b-acct-01", "cat": "synergy accounts", "say": "what accounts do I have", "expect": { "command": "accounts" }, "text": "slack.*todoist.*dropbox" },
        { "id": "b-acct-02", "cat": "synergy accounts", "say": "which accounts are connected", "expect": { "command": "accounts" } }
    ]
}
