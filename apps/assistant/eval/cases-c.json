{
 "about": "The everyday features (docs/AI-AND-MCP.md \"Everyday features\"; lib/commands-everyday.js): what did I miss, driving mode, announcing messages, routines, the camera and voice memos, places, music, quick facts, settings by voice, emergency calls, the home. Ids start with c- (tools/eval-assistant.cjs reads every cases-*.json beside cases.json).",
 "cases": [
  { "id": "c-notif-01", "cat": "notifications", "say": "what did I miss",
    "deviceState": { "notifications": [
      { "id": "n1", "appId": "org.webosphoenix.messaging", "app": "Messaging", "title": "Sam Delgado", "body": "Running 5 min late", "time": 1791360000000 },
      { "id": "n2", "appId": "com.palm.app.email", "app": "Email", "title": "Alex Rivera", "body": "Invoice 2231", "time": 1791356400000 } ] },
    "expect": { "command": "notifications", "args": { "app": "" } }, "text": "From Messaging: Sam Delgado.*From Email: Alex Rivera" },
  { "id": "c-notif-02", "cat": "notifications", "say": "read my notifications",
    "deviceState": { "notifications": [ { "id": "n1", "appId": "org.webosphoenix.messaging", "app": "Messaging", "title": "Priya Nair", "body": "Lunch at noon?", "time": 1791360000000 } ] },
    "expect": { "command": "notifications" }, "text": "Priya Nair, .Lunch at noon" },
  { "id": "c-notif-03", "cat": "notifications", "say": "any new notifications from email",
    "deviceState": { "notifications": [
      { "id": "n1", "appId": "org.webosphoenix.messaging", "app": "Messaging", "title": "Sam Delgado", "body": "Running late", "time": 1791360000000 },
      { "id": "n2", "appId": "com.palm.app.email", "app": "Email", "title": "Alex Rivera", "body": "Invoice 2231", "time": 1791356400000 } ] },
    "expect": { "command": "notifications", "args": { "app": "email" } }, "text": "Alex Rivera", "notText": "Sam Delgado" },
  { "id": "c-notif-04", "cat": "notifications", "say": "do I have any notifications",
    "expect": { "command": "notifications" }, "text": "caught up" },
  { "id": "c-notif-05", "cat": "notifications", "say": "what did I miss",
    "deviceState": { "deviceLocked": true, "previews": false, "notifications": [
      { "id": "n1", "appId": "org.webosphoenix.messaging", "app": "Messaging", "title": "Sam Delgado", "body": "Running 5 min late", "time": 1791360000000 } ] },
    "expect": { "command": "notifications" }, "text": "1 from Messaging.*Unlock", "notText": "Sam|Running" },
  { "id": "c-notif-06", "cat": "notifications", "say": "catch me up",
    "expect": { "command": "notifications" } },
  { "id": "c-notif-07", "cat": "notifications", "say": "did I miss any calls",
    "expect": { "command": "callLog", "args": { "missed": true } } },
  { "id": "c-notif-08", "cat": "notifications", "say": "check my notifications please",
    "expect": { "command": "notifications" } },
  { "id": "c-drive-01", "cat": "driving", "say": "I'm driving",
    "expect": { "command": "drivingMode", "args": { "state": "on" } }, "text": "Driving mode is on" },
  { "id": "c-drive-02", "cat": "driving", "say": "turn on driving mode",
    "expect": { "command": "drivingMode", "args": { "state": "on" } } },
  { "id": "c-drive-03", "cat": "driving", "turns": [
    { "say": "I'm in the car", "expect": { "command": "drivingMode", "args": { "state": "on" } } },
    { "say": "is driving mode on", "expect": { "command": "drivingMode", "args": { "state": "status" } }, "text": "^Yes" },
    { "say": "I'm done driving", "expect": { "command": "drivingMode", "args": { "state": "off" } }, "text": "Driving mode is off" } ] },
  { "id": "c-drive-04", "cat": "driving", "say": "don't turn on driving mode",
    "expect": { "answer": "chat" }, "forbid": ["drivingMode"] },
  { "id": "c-drive-05", "cat": "driving", "say": "driving mode off",
    "expect": { "command": "drivingMode", "args": { "state": "off" } }, "text": "already off" },
  { "id": "c-announce-01", "cat": "driving", "say": "announce my messages on my headphones",
    "expect": { "command": "announceMessages", "args": { "state": "on" } } },
  { "id": "c-announce-02", "cat": "driving", "say": "stop announcing messages",
    "expect": { "command": "announceMessages", "args": { "state": "off" } } },
  { "id": "c-announce-03", "cat": "driving", "say": "read my texts aloud when they come in",
    "expect": { "command": "announceMessages", "args": { "state": "on" } } },
  { "id": "c-routine-01", "cat": "routines", "say": "good night",
    "storage": { "assistant:routines": [ { "id": "r1", "name": "Good night", "phrases": ["good night", "bedtime"], "enabled": true, "time": "", "days": [], "events": [],
                                          "steps": [ { "text": "turn on do not disturb" }, { "text": "what alarms do I have" } ] } ] },
    "expect": { "command": "routine", "args": { "name": "Good night" } }, "text": "^Good night\\. Do Not Disturb is on.*alarms" },
  { "id": "c-routine-02", "cat": "routines", "say": "good night",
    "expect": { "answer": "chat" }, "forbid": ["routine", "toggle"] },
  { "id": "c-routine-03", "cat": "routines", "say": "run my bedtime routine",
    "storage": { "assistant:routines": [ { "id": "r1", "name": "Good night", "phrases": ["good night", "bedtime"], "enabled": true, "time": "", "days": [], "events": [],
                                          "steps": [ { "text": "turn on do not disturb" } ] } ] },
    "expect": { "command": "routine", "args": { "name": "Good night" } } },
  { "id": "c-routine-04", "cat": "routines", "say": "what routines do I have",
    "storage": { "assistant:routines": [ { "id": "r1", "name": "Good night", "phrases": ["good night"], "enabled": true, "steps": [ { "text": "turn on do not disturb" } ] },
                                         { "id": "r2", "name": "Good morning", "phrases": ["good morning"], "enabled": false, "steps": [ { "text": "turn off do not disturb" } ] } ] },
    "expect": { "command": "routineList" }, "text": "Good night and Good morning \\(off\\)" },
  { "id": "c-routine-05", "cat": "routines", "say": "delete my good night routine",
    "storage": { "assistant:routines": [ { "id": "r1", "name": "Good night", "phrases": ["good night"], "enabled": true, "steps": [ { "text": "turn on do not disturb" } ] } ] },
    "expect": { "command": "routineManage", "status": "pending", "args": { "action": "delete" } } },
  { "id": "c-routine-06", "cat": "routines", "say": "make a new routine",
    "expect": { "command": "routineList", "args": { "create": true } } },
  { "id": "c-cam-01", "cat": "camera", "say": "take a photo", "expect": { "command": "camera", "args": { "action": "photo", "front": false } } },
  { "id": "c-cam-02", "cat": "camera", "say": "take a selfie in 3 seconds", "expect": { "command": "camera", "args": { "action": "photo", "front": true, "delay": 3 } }, "text": "in 3 seconds" },
  { "id": "c-cam-03", "cat": "camera", "say": "take a picture with a 10 second timer", "expect": { "command": "camera", "args": { "action": "photo", "delay": 10 } } },
  { "id": "c-cam-04", "cat": "camera", "say": "record a video", "expect": { "command": "camera", "args": { "action": "video" } } },
  { "id": "c-cam-05", "cat": "camera", "say": "take a screenshot", "expect": { "command": "screenshot" }, "forbid": ["camera"] },
  { "id": "c-cam-06", "cat": "camera", "say": "record a voice memo called groceries", "expect": { "command": "voiceMemo", "args": { "title": "Groceries" } } },
  { "id": "c-cam-07", "cat": "camera", "turns": [
    { "say": "record a video", "expect": { "command": "camera", "args": { "action": "video" } } },
    { "say": "stop recording", "expect": { "command": "stopRecording" }, "text": "video" } ] },
  { "id": "c-cam-08", "cat": "camera", "say": "take a note", "forbid": ["voiceMemo", "camera"], "expect": { "answer": ["clarify", "fallback", "chat"] } },
  { "id": "c-routine-07", "cat": "routines", "say": "good morning",
    "storage": { "assistant:routines": [ { "id": "r2", "name": "Good morning", "phrases": ["good morning"], "enabled": false, "steps": [ { "text": "turn off do not disturb" } ] } ] },
    "expect": { "answer": "chat" }, "forbid": ["routine", "toggle"] },
  { "id": "c-park-01", "cat": "places", "say": "remember where I parked", "expect": { "command": "parking", "args": { "action": "save" } }, "text": "saved where you parked" },
  { "id": "c-park-02", "cat": "places", "say": "I parked on level 3", "expect": { "command": "parking", "args": { "action": "save", "note": "on level 3" } } },
  { "id": "c-park-03", "cat": "places", "turns": [
    { "say": "I parked here", "expect": { "command": "parking", "args": { "action": "save" } } },
    { "say": "where's my car", "expect": { "command": "findParking" }, "text": "Your car is right around here" } ] },
  { "id": "c-park-04", "cat": "places", "say": "where did I park",
    "storage": { "assistant:parking": { "lat": 37.373, "lon": -122.04, "at": 1791358200000, "note": "", "address": "" } },
    "expect": { "command": "findParking" }, "text": "about 0\\.2 miles north of here" },
  { "id": "c-park-05", "cat": "places", "say": "where did I park", "expect": { "command": "findParking" }, "text": "don't know where you parked" },
  { "id": "c-park-06", "cat": "places", "say": "I've parked", "expect": { "command": "drivingMode", "args": { "state": "off" } } },
  { "id": "c-place-01", "cat": "places", "say": "remind me to buy milk when I get home",
    "db": [ { "_id": "pl-home", "_kind": "org.webosphoenix.maps.place:1", "name": "Home", "detail": "", "lat": 37.40, "lon": -122.08, "created": 1, "searchText": "home" } ],
    "expect": { "command": "placeReminder", "args": { "text": "buy milk", "place": "home", "when": "arrive" } }, "text": "remind you to buy milk when you get home",
    "effects": [ { "kind": "com.palm.task:1", "where": { "summary": { "$re": "buy milk" }, "notes": "When you get home" }, "count": 1 } ] },
  { "id": "c-place-02", "cat": "places", "say": "when I leave work remind me to call Mom",
    "db": [ { "_id": "pl-work", "_kind": "org.webosphoenix.maps.place:1", "name": "Work", "detail": "", "lat": 37.37, "lon": -122.04, "created": 1, "searchText": "work" } ],
    "expect": { "command": "placeReminder", "args": { "place": "work", "when": "leave" } }, "text": "when you leave work" },
  { "id": "c-place-03", "cat": "places", "say": "remind me to email Sam when I get to work",
    "expect": { "command": "placeReminder", "args": { "place": "work", "when": "arrive" } }, "text": "don't know where your work is yet" },
  { "id": "c-place-04", "cat": "places", "say": "remind me to take the trash out at 7", "expect": { "command": "reminder" }, "forbid": ["placeReminder"] },
  { "id": "c-place-05", "cat": "places", "say": "remind me to lock the door when I leave", "expect": { "command": "placeReminder", "args": { "place": "here", "when": "leave" } } },
  { "id": "c-place-06", "cat": "places", "say": "this is my home", "expect": { "command": "setPlace", "args": { "place": "home" } },
    "effects": [ { "kind": "org.webosphoenix.maps.place:1", "where": { "name": "Home" }, "count": 1 } ] },
  { "id": "c-place-07", "cat": "places", "say": "remind me to buy flowers when I get to the market",
    "expect": { "command": "placeReminder", "args": { "when": "arrive" } }, "text": "don't know where .Market. is" },
  { "id": "c-place-08", "cat": "places", "say": "navigate home", "expect": { "command": "navigate" }, "forbid": ["placeReminder", "setPlace"] }
 ]
}
