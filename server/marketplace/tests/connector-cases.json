        {"name": "a sign-up page that is not https", "set": {"public/accounts/org.example.foo/org.example.foo.json": {"templateId": "org.example.foo", "loc_name": "Foo", "icon": {"loc_32x32": "images/foo-32.png", "loc_48x48": "images/foo-48.png"}, "validator": {"address": "palm://org.example.service.foo/checkCredentials"}, "capabilityProviders": [{"capability": "CONTACTS", "id": "org.example.foo.contacts", "loc_name": "Contacts", "dbkinds": {"contact": "com.palm.contact.foo:1"}, "implementation": "palm://org.example.service.foo/", "onCreate": "palm://org.example.service.foo/onCreate", "onEnabled": "palm://org.example.service.foo/onEnabled", "onDelete": "palm://org.example.service.foo/onDelete", "sync": "palm://org.example.service.foo/sync"}], "signUp": {"url": "http://example.com/join"}}}, "expect": ["C16"]},
