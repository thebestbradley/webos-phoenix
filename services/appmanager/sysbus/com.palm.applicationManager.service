#
# The legacy application manager on OSE, over SAM (services/appmanager).
# Started by the hub when an app first calls it.

[D-BUS Service]
Name=com.palm.applicationManager
Exec=/usr/bin/run-js-service -n /usr/palm/services/com.palm.applicationManager
Type=dynamic
